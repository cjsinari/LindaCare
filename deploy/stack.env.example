# Copy to the repo root as `.env` on the VPS and fill in every value. `.env` is gitignored.
# Generate each secret separately:   openssl rand -hex 32

# ── Public addresses ─────────────────────────────────────────────────────────
# With no domain, use sslip.io: it resolves a name to the IP inside it, and Caddy can
# get a real certificate for it. For a VPS at 203.0.113.7:
#   DOMAIN=203-0-113-7.sslip.io        APP_DOMAIN=app.203-0-113-7.sslip.io
DOMAIN=
APP_DOMAIN=
ACME_EMAIL=

# ── Database ─────────────────────────────────────────────────────────────────
# PG_MAJOR must be the same major version as the database the schema is exported
# from (psql --version on your laptop). A newer dump can fail on an older server.
PG_MAJOR=17
DB_NAME=mzazicare_auth
DB_USER=lindacare
DB_PASSWORD=

# ── Auth service secrets (new values for production, not the ones in your dev .env) ──
JWT_SECRET=
OTP_SECRET=
NATIONAL_ID_SECRET=

# ── Africa's Talking: the LIVE app's username and API key, not "sandbox" ─────
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=

# ── Optional: email channel for account recovery ─────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LindaCare <no-reply@lindacare.co.ke>

# ── Expo web build ───────────────────────────────────────────────────────────
# true: every role sees every action button and responses show their status code
# (what the defence demo needs). false: the normal role-aware interface.
DEMO_MODE=true

# ── Fallback if SMS delivery fails on the day (see DEPLOY.md, section 9) ─────
# APP_ENV=staging
# OTP_DEV_MODE=true
