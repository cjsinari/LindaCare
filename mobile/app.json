{
  "expo": {
    "name": "LindaCare",
    "slug": "lindacare",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "lindacare",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#15314f",
      "resizeMode": "contain"
    },
    "android": {
      "package": "ke.co.lindacare.app",
      "adaptiveIcon": {
        "backgroundColor": "#15314f"
      },
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "ke.co.lindacare.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#17807d"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://192.168.100.7:3000",
      "careApi": "auto",
      "demoMode": false,
      "eas": {
        "projectId": "af3eea61-bba1-451e-a8f0-acf91716d62d"
      }
    },
    "owner": "cjsinari"
  }
}
